# Cloudflare static-asset headers for juego.chiguibara.es.
/*
  # Only chiguibara.es (and its preview deployments) may embed the game.
  Content-Security-Policy: frame-ancestors 'self' https://chiguibara.es https://www.chiguibara.es https://*.workers.dev
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Always check for a new version of the app shell after each deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
